{
  "name": "chee",
  "version": "2.0.1",
  "description": "Stockfish eval bar and move feedback in games against chess.com bots only",
  "author": "Hong4rc <hong4rc@gmail.com>",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ram4nd/chee.git"
  },
  "homepage": "https://github.com/ram4nd/chee",
  "bugs": {
    "url": "https://github.com/ram4nd/chee/issues"
  },
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint src/ static/stockfish-worker.js",
    "lint:fix": "eslint src/ static/stockfish-worker.js --fix",
    "test": "vitest run",
    "posttest": "git rev-parse HEAD > .test-passed",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "pack": "npm run build && cd dist && zip -r ../chee-v$(node -p \"require('../package.json').version\").zip . -x '.*'",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3.3.7",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "rollup": "^4.66.0",
    "rollup-plugin-copy": "^3.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "lodash-es": "^4.18.1"
  }
}
